# Append these to backend/.env.example (never commit real values)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # server-side only
OPENCORPORATES_API_TOKEN=        # optional: enables company registry check
ANTHROPIC_API_KEY=               # optional: LLM extraction + plain-language explanation
ANTHROPIC_MODEL=claude-sonnet-5-5
STORE_INPUT_TEXT=false           # true = store redacted input text
